# Copy to .env.local or .env, fill these in, then restart the server.
# All three values are SERVER-ONLY: do not prefix them with NEXT_PUBLIC_.

# Neon direct or pooled Postgres connection string for the same branch as Neon Auth.
# Example format: postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=

# Enable managed Neon Auth in the Neon console and copy its Auth endpoint URL.
NEON_AUTH_BASE_URL=

# Generate a random secret (32+ characters) with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=

# Apply neon/migrations/001_training_state.sql and follow neon/README.md.
# Deploy as a Next.js server app (e.g. Vercel), not a static out/ export.
